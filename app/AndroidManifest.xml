<?xml version="1.0" encoding="utf-8"?>
<!-- Пакет com.jmgo.*: системный hippo не закрывает такие приложения (ни при переключении, ни при уходе в сон).
     Классы остаются в io.github.jmgotemp. До 1.3 пакет был io.github.jmgotemp. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jmgo.jmgotemp"
    android:versionCode="10"
    android:versionName="1.5.1">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- только для «Применять после включения проектора» (по умолчанию выключено) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="JMGO Temp"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name="io.github.jmgotemp.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name="io.github.jmgotemp.OverlayService" android:exported="false" />
        <service android:name="io.github.jmgotemp.WatchService" android:exported="false" />
        <receiver android:name="io.github.jmgotemp.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
